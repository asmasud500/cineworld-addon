{
  "name": "cineworld-addon",
  "version": "0.3.2",
  "private": false,
  "description": "Legal-first movie catalog add-on for Stremio and Nuvio",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "stremio-addon-sdk": "^1.6.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/express": "^5.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "tmp": "0.2.7"
  }
}
