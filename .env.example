# Single HTTP listener for Stremio/Nuvio add-on routes and health API
PORT=7000
PUBLIC_BASE_URL=http://localhost:7000

# Comma-separated HTTPS manifest URLs for Stremio-compatible catalog add-ons.
# Defaults to IndiaStreams. This is a server-side list; it cannot read the add-ons installed in a user's Nuvio app.
UPSTREAM_CATALOG_ADDONS=https://83e20802dcf1-indian-streams.baby-beamup.club/manifest.json,https://indiastreams.rdata.in/manifest.json

# Optional future admin API protection
ADMIN_API_TOKEN=

# Legal playback: only reviewed, explicitly licensed/public-domain URLs belong here.
# Do not paste scraped, paywalled, or unauthorized streaming URLs.

# Automatic new-release discovery (metadata only, no playback links).
# Free key: https://www.themoviedb.org/settings/api  -> use EITHER the v3 API key OR the v4 read access token.
# Without one, the add-on still works but new films only appear once the upstream add-ons list them.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Admin page (/admin) for pinning/hiding films. Choose a long random value; leave empty to disable the admin.
# ADMIN_API_TOKEN is also used above; permanent pin/hide lists (comma-separated film ids):
PINNED_MOVIE_IDS=
HIDDEN_MOVIE_IDS=
# Set to false to stop the add-on pinging its own public URL (keep-alive on free hosts).
KEEP_ALIVE=true

# Countries whose official streaming services are shown on a movie page (two-letter codes, comma-separated).
WATCH_REGIONS=BD,IN

# Where the admin panel saves its lists (default under ./data). Use a persistent disk path if your host has one.
SOURCES_FILE=data/sources.json
SUBTITLES_FILE=data/subtitles.json
OVERRIDES_FILE=data/overrides.json
CURATED_FILE=data/movies.json
