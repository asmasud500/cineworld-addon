# Single HTTP listener for Stremio/Nuvio add-on routes and health API
PORT=7000
PUBLIC_BASE_URL=http://localhost:7000

# Comma-separated HTTPS manifest URLs for Stremio-compatible catalog add-ons.
# Defaults to IndiaStreams. This is a server-side list; it cannot read the add-ons installed in a user's Nuvio app.
UPSTREAM_CATALOG_ADDONS=https://indiastreams.rdata.in/manifest.json

# Optional future admin API protection
ADMIN_API_TOKEN=

# Legal playback: only reviewed, explicitly licensed/public-domain URLs belong here.
# Do not paste scraped, paywalled, or unauthorized streaming URLs.
